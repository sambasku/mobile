# Copy ke .env (git-ignored) - host dipilih otomatis per flavor (env.dart)
SAMBASKU_API_HOST_STAGING=https://sambasku-staging.iamutaki.com
SAMBASKU_API_HOST_PRODUCTION=https://api.sambasku.com

# Tier cadangan produksi untuk circuit breaker (docs/backlogs/FAILOVER.md).
# Urutan tetap: tier 1 = HOST_PRODUCTION, lalu FALLBACK, lalu FALLBACK2.
# Kosong = tier itu tidak ada dan interceptor diam. Staging tanpa cadangan.
SAMBASKU_API_HOST_FALLBACK_PRODUCTION=https://deno.sambasku.com
SAMBASKU_API_HOST_FALLBACK2_PRODUCTION=https://render.sambasku.com

# Domain web publik (caption share + deep link HTTPS). Bukan host API.
SAMBASKU_WEB_APP_URL_STAGING=https://sambasku-web-staging.iamutaki.com
SAMBASKU_WEB_APP_URL_PRODUCTION=https://sambasku.com

# OAuth client ID per flavor (sama dengan API GOOGLE_CLIENT_ID env
# matching). Kosong = tombol Google disembunyikan. Bukan secret.
GOOGLE_WEB_CLIENT_ID_STAGING=
GOOGLE_WEB_CLIENT_ID_PRODUCTION=

# Facebook App ID per flavor (sama dengan API FACEBOOK_APP_ID env
# matching). Kosong = tombol Facebook disembunyikan. Bukan secret.
# App Secret HANYA di backend. Client Token SDK di native (Android
# strings.xml / iOS Info.plist), lihat docs/mobile/19-mobile-auth-facebook.md.
FACEBOOK_APP_ID_STAGING=
FACEBOOK_APP_ID_PRODUCTION=

# GitHub OAuth App Client ID per flavor (sama dengan API GITHUB_CLIENT_ID).
# Kosong = tombol GitHub disembunyikan. Bukan secret.
# Callback GitHub (https, wajib):
#   staging    https://sambasku-web-staging.iamutaki.com/oauth/github
#   production https://sambasku.com/oauth/github
GITHUB_CLIENT_ID_STAGING=
GITHUB_CLIENT_ID_PRODUCTION=

# Opsional - untuk fitur upload gambar direct (menyusul)
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_URL_ENDPOINT=

# CDN config card dinamis (repo data via jsDelivr). Bukan secret.
SAMBASKU_CARD_CONFIG_URL_STAGING=https://cdn.jsdelivr.net/gh/sambasku/data@main/mobile/home.json
SAMBASKU_CARD_CONFIG_URL_PRODUCTION=https://cdn.jsdelivr.net/gh/sambasku/data@main/mobile/home.json
